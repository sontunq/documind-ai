# Example only. Create the database/user locally and replace the password.
DATABASE_URL=postgresql+psycopg://documind:replace-me@localhost:5432/documind
DOCUMENT_STORAGE_DIR=.runtime/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=25000000
OCR_AUTO_PROCESS=true
OCR_PDF_DPI=144
OCR_CPU_THREADS=2
OCR_QUEUE_CAPACITY=8
OCR_CACHE_DIR=.runtime/paddlex
CLASSIFICATION_MODEL_PATH=.runtime/classification/baseline.joblib
